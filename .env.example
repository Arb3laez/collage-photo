# Configuración web de Firebase (para sincronizar entre dispositivos).
# Copia estos valores desde la consola de Firebase:
#   Project settings -> General -> Your apps -> SDK setup and configuration.
# NOTA: estas claves NO son secretas (viajan en el cliente); la seguridad
# se controla con las reglas de Firestore.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
